# =============================================================================
# IBM Cloud Configuration
# =============================================================================

# IBM Cloud API Key (required for API key auth, not needed for OIDC)
IBM_CLOUD_API_KEY=replace-with-ibm-api-key

# IBM Cloud region (default: us-south)
IBM_CLOUD_REGION=us-south

# Code Engine project ID (find in IBM Cloud Console > Code Engine > Projects)
IBM_CODE_ENGINE_PROJECT_ID=your-project-id
# Container image reference to deploy to Code Engine
# Example: us.icr.io/my-namespace/my-app:latest
# Public Docker Hub example: docker.io/my-user/ibmcloudvercel-welcome:latest
IBM_CODE_ENGINE_IMAGE_REFERENCE=docker.io/cobberr/ibmcloudvercel-welcome:latest

# Cloud Object Storage settings
IBM_COS_SERVICE_INSTANCE_ID=crn:v1:bluemix:public:cloud-object-storage:global:a/your-account-id:::
IBM_COS_BUCKET_NAME=your-bucket-name

# Optional: Trusted Profile ID for OIDC authentication (more secure than API keys)
# IBM_TRUSTED_PROFILE_ID=Profile-xxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Optional: Code Engine polling tunables (seconds)
# IBM_CODE_ENGINE_POLL_INTERVAL=5
# IBM_CODE_ENGINE_POLL_TIMEOUT=600
# IBM_CODE_ENGINE_POLL_REQUEST_TIMEOUT=10

# =============================================================================
# Vercel Configuration (auto-injected in Vercel builds, set for local testing)
# =============================================================================

# OIDC token (auto-injected by Vercel, don't set manually)
# VERCEL_OIDC_TOKEN=

VERCEL_DEPLOYMENT_ID=test-local
VERCEL_PROJECT_NAME=ibmcloudvercel
VERCEL_GIT_COMMIT_REF=local-dev
VERCEL_GIT_COMMIT_SHA=0000000
VERCEL_CHECKS_TOKEN=replace-with-vercel-checks-token
# Team scope used for checks API in integration mode (optional locally)
# VERCEL_TEAM_ID=team_xxxxx

# =============================================================================
# Integration Backend Settings (required when running integration_service.py)
# =============================================================================

# Integration HTTP host/port
INTEGRATION_HOST=127.0.0.1
INTEGRATION_PORT=8787

# Installation token persistence path
INTEGRATION_STORE_PATH=.ibmcloudvercel/installations.json

# Webhook signature secret (must match Vercel integration webhook secret)
VERCEL_WEBHOOK_SECRET=replace-with-vercel-webhook-secret

# Command executed asynchronously for deployment.ready events
INTEGRATION_DEPLOY_COMMAND=python deploy_ibm.py

# Optional best-effort cleanup command executed on uninstall
# INTEGRATION_UNINSTALL_CLEANUP_COMMAND=python scripts/cleanup_installation.py

# =============================================================================
# Local Validation / Optional Settings
# =============================================================================

# Dry-run mode validates config/payload flow without cloud mutation
# IBM_CLOUD_VERCEL_DRY_RUN=true

# Delete zip files after upload (default: true in config file)
# CLEANUP_ARTIFACTS=true
